@inproceedings{freymuth2025charm,
Title = {Hierarchical Multi-field Representations for Two-stage E-commerce Retrieval},
Author={Freymuth, N. and Liu, Dong and others},
Year={2026},
Booktitle={LID Workshop at ECIR 2026},
Url={https://arxiv.org/abs/2501.18707},
Abstract={This paper proposes a hierarchical multi-field representation framework for product retrieval in large-scale e-commerce search. The model jointly learns text, metadata, and multimodal features in a two-stage retrieval pipeline—combining semantic recall and fine-grained ranking. Experiments on real-world Amazon data demonstrate substantial improvements in retrieval accuracy and cross-domain generalization.}
}

@inproceedings{blandon2025memerag,
Title = {MEMERAG: A Multilingual End-to-End Meta-evaluation Benchmark for Retrieval-Augmented Generation},
Author={Blandón, M. A. C. and Talur, J. and Charron, B. and Liu, Dong and others},
Year={2025},
Booktitle={ACL 2025},
Abstract={MEMERAG introduces the first multilingual benchmark for evaluating Retrieval-Augmented Generation (RAG) systems across diverse languages. It integrates retrieval quality, generation consistency, and factual grounding into a unified evaluation framework. The dataset covers multiple domains and languages, providing standardized metrics for cross-lingual assessment of RAG models.}
}

@inproceedings{liu2025brand,
Title = {Bridging Queries and Brands: Entity Linking for Large-Scale Product Search},
Author={Liu, Dong and Nag, Sreyashi},
Year={2026},
Booktitle={CIKM 2026},
Url={https://arxiv.org/abs/2502.01555},
Abstract={This paper tackles brand entity linking in e-commerce query understanding. The work presents a two-stage approach combining named-entity recognition with matching, and a novel end-to-end solution using extreme multi-class classification. The solution was validated by both offline benchmarks and the impact of online A/B test.}
}

@inproceedings{liu2025multimodal,
Title = {Multimodal Semantic Retrieval for Product Search},
Author={Liu, Dong and Ramos, E. L.},
Year={2025},
Booktitle={EReL@MIR Workshop 2025 (WWW Conference Companion)},
Abstract={The study presents a multimodal retrieval model that jointly learns semantic representations from textual and visual product data. By fusing image and description embeddings using a transformer-based encoder, the system captures cross-modal correlations that enhance product search relevance. Evaluations show strong performance in product retrieval scenario.}
}

